# Local Docker database owner URL. Application data operations use the
# separate reader/admin URLs below; do not use the owner URL for either role.
DATABASE_URL=postgresql://queryra_owner:queryra_dev_only_change_me@127.0.0.1:55432/queryra

# Explicit database target. Local npm development defaults to local; production
# defaults to hosted. Set hosted only after provisioning the restricted roles.
DATABASE_TARGET=local

# Required local role passwords for Docker Compose. Use different generated,
# URL-safe local-only values. The initialization script consumes these values.
QUERYRA_POSTGRES_READER_PASSWORD=
QUERYRA_POSTGRES_INGEST_PASSWORD=

# Local app-process URLs. Next expands these references from the password vars.
# Docker Compose builds its internal URLs separately using these same values.
DATABASE_LOCAL_READER_URL=postgresql://queryra_reader:$QUERYRA_POSTGRES_READER_PASSWORD@127.0.0.1:55432/queryra
DATABASE_LOCAL_ADMIN_URL=postgresql://queryra_ingest:$QUERYRA_POSTGRES_INGEST_PASSWORD@127.0.0.1:55432/queryra

# Hosted Supabase PostgreSQL role connections. Required when DATABASE_TARGET=hosted.
# Reader: SELECT on the workspace-prefixed datasets only, NOBYPASSRLS.
# Ingestion: restricted CREATE/INSERT only, NOBYPASSRLS; keep distinct from reader.
DATABASE_READER_URL=
DATABASE_ADMIN_URL=
# Supabase root CA PEM file; required for hosted Supabase PostgreSQL.
DATABASE_SSL_CA_FILE=./certs/supabase-ca.crt



# Supabase Auth project. The URL and publishable key are public client config.
# Use the same new project for Auth and the hosted PostgreSQL database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for Gemini SQL generation and Gemini review of Ollama drafts.
GOOGLE_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# Optional Ollama model server. This host URL is for `npm run dev` on this machine.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional Ollama address used only by Docker Compose. `host.docker.internal`
# routes from the app container back to Ollama on the host machine.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434

# Optional database/runtime controls (defaults shown; limits are validated).
DB_POOL_MAX=5
DB_POOL_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_CONCURRENCY=5
DB_INGEST_CONCURRENCY=1
MAX_RESULT_BYTES=2000000

# Process-local limits (not shared between replicas or users).
GEMINI_REQUESTS_PER_MINUTE=20
OLLAMA_REQUESTS_PER_MINUTE=20
PROVIDER_CONCURRENCY=2
CSV_UPLOADS_PER_10_MINUTES=20

# Local Docker Compose settings only. These example credentials are public,
# development-only defaults; never reuse them outside loopback development.
QUERYRA_POSTGRES_PASSWORD=queryra_dev_only_change_me
QUERYRA_POSTGRES_PORT=55432
QUERYRA_PORT=3000

# Leave blank for TLS defaults. Set to "disable" only for trusted local Postgres.
PGSSL=

# Supabase Auth uses only the public URL/publishable key above. No service-role
# key is required. Redirect URLs are configured in the Supabase Auth dashboard.
