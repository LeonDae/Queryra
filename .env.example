# Local development fallback. In production use separate least-privilege roles below.
DATABASE_URL=postgresql://queryra_local:replace-me@127.0.0.1:5432/queryra

# Production query role: SELECT only on explicitly authorized schemas/tables.
# Required when NODE_ENV=production.
DATABASE_READER_URL=

# Production ingestion role: only required when CSV table ingestion is enabled.
# Keep separate from DATABASE_READER_URL and never use a database superuser here.
DATABASE_ADMIN_URL=

# Required for Gemini cloud generation and the Gemini review step in hybrid mode.
GOOGLE_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# Optional Ollama server reachable from the Next.js server process/container.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Docker Compose uses the host bridge address, since localhost inside the app
# container refers to the container itself.
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434

# Optional runtime controls (defaults shown).
DB_POOL_MAX=5
DB_POOL_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
MAX_RESULT_BYTES=2000000

# Process-local development limits (not shared across replicas or users).
GEMINI_REQUESTS_PER_MINUTE=20
OLLAMA_REQUESTS_PER_MINUTE=20
PROVIDER_CONCURRENCY=2
CSV_UPLOADS_PER_10_MINUTES=3

# Local-only Docker Compose defaults. Never reuse these passwords in production.
QUERYRA_POSTGRES_PASSWORD=queryra_dev_only_change_me
QUERYRA_POSTGRES_PORT=55432
QUERYRA_PORT=3000

# Use PGSSL=disable only for a trusted local PostgreSQL instance without TLS.
# PGSSL=disable
